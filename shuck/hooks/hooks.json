{
  "description": "Run shuck check --fix on shell files after Claude edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-shuck.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
