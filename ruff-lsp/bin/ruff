#!/usr/bin/env bash
# Wrapper that prefers the current project's venv: it walks up from the
# current directory looking for `.venv/bin/ruff` (your per-project venv
# pattern), then falls back to ruff on PATH, then to `~/.venv/bin/ruff`.
# Used by .lsp.json so the LSP launcher uses the project's ruff.

set -eu

# Walk up from cwd looking for a project venv.
dir="$PWD"
while :; do
  if [[ -x "$dir/.venv/bin/ruff" ]]; then
    exec "$dir/.venv/bin/ruff" "$@"
  fi
  parent="$(dirname "$dir")"
  [[ "$parent" == "$dir" ]] && break
  dir="$parent"
done

if real="$(command -v ruff 2>/dev/null)" && [[ -x "$real" && "$real" != "$0" ]]; then
  exec "$real" "$@"
fi

if [[ -x "$HOME/.venv/bin/ruff" ]]; then
  exec "$HOME/.venv/bin/ruff" "$@"
fi

echo "ruff wrapper: ruff not found in any .venv/bin/ walking up from $PWD, on PATH, or in ~/.venv/bin" >&2
exit 127
