#!/usr/bin/env bash
# Wrapper that finds ruff on PATH first, then walks up from the current
# directory looking for a `.venv/bin/ruff` (your per-project venv pattern),
# then falls back to `~/.venv/bin/ruff`. Used by .lsp.json so the LSP
# launcher doesn't depend on the harness's PATH.

set -eu

if real="$(command -v ruff 2>/dev/null)" && [[ -x "$real" && "$real" != "$0" ]]; then
  exec "$real" "$@"
fi

# Walk up from cwd looking for a project venv.
dir="$PWD"
while :; do
  if [[ -x "$dir/.venv/bin/ruff" ]]; then
    exec "$dir/.venv/bin/ruff" "$@"
  fi
  parent="$(dirname "$dir")"
  [[ "$parent" == "$dir" ]] && break
  dir="$parent"
done

if [[ -x "$HOME/.venv/bin/ruff" ]]; then
  exec "$HOME/.venv/bin/ruff" "$@"
fi

echo "ruff wrapper: ruff not found on PATH, in any .venv/bin/ walking up from $PWD, or in ~/.venv/bin" >&2
exit 127
