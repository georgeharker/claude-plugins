{
  "description": "Run ruff check --fix and ruff format on Python files after Claude edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-ruff.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
