#!/usr/bin/env bash
# claude-plugin-tool-wrapper
# Resolve the ruff binary, preferring the most explicit signal of intent:
#   1. $VIRTUAL_ENV/bin/ruff  — an activated venv (survives a stripped PATH)
#   2. first real ruff on PATH — respects activation, pyenv/conda shims, globals
#   3. .venv/bin/ruff walking up from cwd — a project venv on disk but not active
#   4. ~/.venv/bin/ruff       — personal global fallback
# Shared by the LSP entry and the fix command/hook so resolution is consistent
# and survives the harness running with a stripped PATH.

set -eu

if [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/ruff" ]]; then
  exec "$VIRTUAL_ENV/bin/ruff" "$@"
fi

# First ruff on PATH that isn't one of these plugin wrappers. Plugin bin dirs
# are added to PATH, so a plain `command -v` would resolve to a wrapper (and two
# wrappers of the same name could ping-pong); the marker grep skips them all.
found=
while IFS= read -r cand; do
  [[ -x "$cand" ]] || continue
  grep -q 'claude-plugin-tool-wrapper' "$cand" 2>/dev/null && continue
  found="$cand"
  break
done < <(type -ap ruff 2>/dev/null)
if [[ -n "$found" ]]; then
  exec "$found" "$@"
fi

dir="$PWD"
while :; do
  if [[ -x "$dir/.venv/bin/ruff" ]]; then
    exec "$dir/.venv/bin/ruff" "$@"
  fi
  parent="$(dirname "$dir")"
  [[ "$parent" == "$dir" ]] && break
  dir="$parent"
done

if [[ -x "$HOME/.venv/bin/ruff" ]]; then
  exec "$HOME/.venv/bin/ruff" "$@"
fi

echo "ruff wrapper: ruff not found via \$VIRTUAL_ENV, on PATH, in any .venv/bin walking up from $PWD, or in ~/.venv/bin" >&2
exit 127
