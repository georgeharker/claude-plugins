{
  "description": "Fallback mypy check after edits, in case the plugin-supplied .lsp.json is not honored by the harness.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/run-mypy.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
