#!/usr/bin/env bash
# Wrapper that prefers the current project's venv: it walks up from cwd
# looking for `.venv/bin/pylsp`, then falls back to pylsp on PATH, then to
# `~/.venv/bin/pylsp`. Used by .lsp.json so the LSP launcher uses the
# project's pylsp (and its installed plugins) rather than a global one.

set -eu

dir="$PWD"
while :; do
  if [[ -x "$dir/.venv/bin/pylsp" ]]; then
    exec "$dir/.venv/bin/pylsp" "$@"
  fi
  parent="$(dirname "$dir")"
  [[ "$parent" == "$dir" ]] && break
  dir="$parent"
done

if real="$(command -v pylsp 2>/dev/null)" && [[ -x "$real" && "$real" != "$0" ]]; then
  exec "$real" "$@"
fi

if [[ -x "$HOME/.venv/bin/pylsp" ]]; then
  exec "$HOME/.venv/bin/pylsp" "$@"
fi

echo "pylsp wrapper: pylsp not found in any .venv/bin/ walking up from $PWD, on PATH, or in ~/.venv/bin" >&2
exit 127
