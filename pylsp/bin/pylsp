#!/usr/bin/env bash
# claude-plugin-tool-wrapper
# Resolve the pylsp binary, preferring the most explicit signal of intent:
#   1. $VIRTUAL_ENV/bin/pylsp  — an activated venv (survives a stripped PATH)
#   2. first real pylsp on PATH — respects activation, pyenv/conda shims, globals
#   3. .venv/bin/pylsp walking up from cwd — a project venv on disk but not active
#   4. ~/.venv/bin/pylsp       — personal global fallback
# Preferring an explicit/active env means pylsp (and its installed plugins, e.g.
# pylsp-mypy) runs against the project's dependencies. Used by .lsp.json.

set -eu

if [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/pylsp" ]]; then
  exec "$VIRTUAL_ENV/bin/pylsp" "$@"
fi

# First pylsp on PATH that isn't one of these plugin wrappers (marker grep).
found=
while IFS= read -r cand; do
  [[ -x "$cand" ]] || continue
  grep -q 'claude-plugin-tool-wrapper' "$cand" 2>/dev/null && continue
  found="$cand"
  break
done < <(type -ap pylsp 2>/dev/null)
if [[ -n "$found" ]]; then
  exec "$found" "$@"
fi

dir="$PWD"
while :; do
  if [[ -x "$dir/.venv/bin/pylsp" ]]; then
    exec "$dir/.venv/bin/pylsp" "$@"
  fi
  parent="$(dirname "$dir")"
  [[ "$parent" == "$dir" ]] && break
  dir="$parent"
done

if [[ -x "$HOME/.venv/bin/pylsp" ]]; then
  exec "$HOME/.venv/bin/pylsp" "$@"
fi

echo "pylsp wrapper: pylsp not found via \$VIRTUAL_ENV, on PATH, in any .venv/bin walking up from $PWD, or in ~/.venv/bin" >&2
exit 127
