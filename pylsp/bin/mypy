#!/usr/bin/env bash
# Wrapper that finds mypy on PATH first, then walks up from cwd looking
# for `.venv/bin/mypy`, then falls back to `~/.venv/bin/mypy`.

set -eu

if real="$(command -v mypy 2>/dev/null)" && [[ -x "$real" && "$real" != "$0" ]]; then
  exec "$real" "$@"
fi

dir="$PWD"
while :; do
  if [[ -x "$dir/.venv/bin/mypy" ]]; then
    exec "$dir/.venv/bin/mypy" "$@"
  fi
  parent="$(dirname "$dir")"
  [[ "$parent" == "$dir" ]] && break
  dir="$parent"
done

if [[ -x "$HOME/.venv/bin/mypy" ]]; then
  exec "$HOME/.venv/bin/mypy" "$@"
fi

echo "mypy wrapper: mypy not found on PATH, in any .venv/bin/ walking up from $PWD, or in ~/.venv/bin" >&2
exit 127
