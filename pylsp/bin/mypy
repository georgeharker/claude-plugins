#!/usr/bin/env bash
# Wrapper that prefers the current project's venv: it walks up from cwd
# looking for `.venv/bin/mypy`, then falls back to mypy on PATH, then to
# `~/.venv/bin/mypy`. Preferring the project venv means mypy type-checks
# against the project's installed dependencies.

set -eu

dir="$PWD"
while :; do
  if [[ -x "$dir/.venv/bin/mypy" ]]; then
    exec "$dir/.venv/bin/mypy" "$@"
  fi
  parent="$(dirname "$dir")"
  [[ "$parent" == "$dir" ]] && break
  dir="$parent"
done

if real="$(command -v mypy 2>/dev/null)" && [[ -x "$real" && "$real" != "$0" ]]; then
  exec "$real" "$@"
fi

if [[ -x "$HOME/.venv/bin/mypy" ]]; then
  exec "$HOME/.venv/bin/mypy" "$@"
fi

echo "mypy wrapper: mypy not found in any .venv/bin/ walking up from $PWD, on PATH, or in ~/.venv/bin" >&2
exit 127
